# ── Servidor ───────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=troque-por-segredo-longo-minimo-32-caracteres
ADMIN_PASSWORD=MudeEstaSenha123!
ADMIN_EMAIL=admin@seusaas.com
# Chave só no servidor — obrigatória para /admin/recuperar-senha (mín. 12 caracteres)
ADMIN_RECOVERY_SECRET=troque-por-chave-longa-de-recuperacao-admin

# ── Banco ──────────────────────────────────────────────
# SQLITE_DB_PATH=/data/database.sqlite

# ── IA (failover: Groq primeiro, Gemini se faltar crédito/limite) ──
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Chave Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Ordem opcional (padrão: groq,gemini)
# AI_PROVIDER_ORDER=groq,gemini

# ── E-mail (recuperação de senha) ──────────────────────
# Sem SMTP, o link de reset aparece no console do servidor
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Filtra.IA <noreply@seudominio.com>"

# ── Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
