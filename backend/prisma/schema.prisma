datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 🏢 Nova tabela para gerenciar os estabelecimentos clientes do seu SaaS
model Business {
  id        String   @id @default(uuid())
  name      String   // Nome da empresa (Ex: Pizzaria do Zé)
  slug      String   @unique // URL amigável (Ex: pizzaria-do-ze)
  createdAt DateTime @default(now())
  reviews   Review[] // Relacionamento: Uma empresa pode ter muitas avaliações
}

// 🏆 Tabela de avaliações atualizada com vínculo obrigatório à empresa
model Review {
  id         String   @id @default(uuid())
  name       String
  rating     Int
  comment    String
  aiReply    String?  
  createdAt  DateTime @default(now())
  
  // Chaves de Relacionamento
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}


