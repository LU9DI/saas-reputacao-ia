# Copie para .env e ajuste os valores
# cp .env.example .env

# --- Segurança (OBRIGATÓRIO mudar) ---
AUTHENTICATION_API_KEY=troque-esta-chave-evolution-32chars
N8N_ENCRYPTION_KEY=troque-esta-chave-n8n-32caracteresxx
POSTGRES_PASSWORD=troque_senha_postgres_forte

# --- Postgres ---
POSTGRES_USER=evolution
POSTGRES_DB=evolution

# --- Evolution ---
SERVER_URL=http://localhost:8080
# Em produção use HTTPS público, ex: https://evolution.seudominio.com

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo

# --- Filtra backend (Render) ---
FILTRA_API_URL=https://filtra-ia-api.onrender.com
# URL do webhook de relatório no n8n (depois de importar o workflow):
# N8N_WEBHOOK_URL=https://seu-n8n/webhook/filtra-relatorio-v3
