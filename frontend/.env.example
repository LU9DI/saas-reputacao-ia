# API principal (tente a mais estável que tiver)
NEXT_PUBLIC_API_URL=https://filtra-ia-api.onrender.com

# Reserva automática (Render / outro). Failover em 502/503/timeout
NEXT_PUBLIC_API_URL_BACKUP=

# Lista extra opcional (vírgula)
# NEXT_PUBLIC_API_URLS=https://api2.example.com,https://api3.example.com

NEXT_PUBLIC_APP_URL=https://filtraai.com

# Google Analytics 4 — Measurement ID da propriedade web (formato G-XXXXXXXXXX).
# Fica em GA4 > Administrador > Fluxos de dados > seu stream web.
# Vazio = a tag NÃO carrega (nenhum evento é enviado). Só é inlined no build:
# defina a variável no ambiente de build (Cloudflare Pages / Render / Vercel).
# Ver docs/ANALYTICS_GA4.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
