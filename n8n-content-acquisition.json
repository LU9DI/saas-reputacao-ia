[
  {
    "id": "filtraContentAcquisition2026",
    "name": "Filtra.AI - Organic Content Drafts",
    "active": false,
    "isArchived": false,
    "settings": {
      "executionOrder": "v1",
      "timezone": "America/Sao_Paulo"
    },
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "15 9 * * 1-5"
              }
            ]
          }
        },
        "id": "ca1",
        "name": "Weekday Content Trigger",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [-720, 0]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{($env.FILTRA_API_URL || 'https://api.filtraai.com') + '/api/n8n/acquisition/content/generate'}}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-Filtra-Secret",
                "value": "={{$env.N8N_INBOUND_SECRET}}"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\"limit\":2}",
          "options": {
            "timeout": 120000,
            "response": {
              "response": {
                "responseFormat": "json"
              }
            }
          }
        },
        "id": "ca2",
        "name": "Generate Drafts",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [-480, 0]
      },
      {
        "parameters": {
          "url": "={{($env.FILTRA_API_URL || 'https://api.filtraai.com') + '/api/n8n/acquisition/content/pending?limit=20'}}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-Filtra-Secret",
                "value": "={{$env.N8N_INBOUND_SECRET}}"
              }
            ]
          },
          "options": {
            "timeout": 30000,
            "response": {
              "response": {
                "responseFormat": "json"
              }
            }
          }
        },
        "id": "ca3",
        "name": "List Pending",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [-240, 0]
      },
      {
        "parameters": {
          "jsCode": "const generated = $('Generate Drafts').first().json || {};\nconst pending = $('List Pending').first().json || {};\nconst items = Array.isArray(pending.items) ? pending.items : [];\nreturn [{\n  json: {\n    ok: true,\n    generated: Number(generated.generated || 0),\n    skipped: Number(generated.skipped || 0),\n    campaign_id: generated.campaign_id || null,\n    pending_review: items.length,\n    sample: items.slice(0, 5).map((item) => ({\n      id: item.id,\n      channel: item.platform,\n      title: item.title,\n      source_url: item.source_url,\n      claim_flags: item.claim_flags || []\n    })),\n    review_url: 'https://filtraai.com/admin/aquisicao'\n  }\n}];"
        },
        "id": "ca4",
        "name": "Summarize Queue",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [0, 0]
      },
      {
        "parameters": {},
        "id": "ca5",
        "name": "Done",
        "type": "n8n-nodes-base.noOp",
        "typeVersion": 1,
        "position": [240, 0]
      }
    ],
    "connections": {
      "Weekday Content Trigger": {
        "main": [
          [
            {
              "node": "Generate Drafts",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Generate Drafts": {
        "main": [
          [
            {
              "node": "List Pending",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "List Pending": {
        "main": [
          [
            {
              "node": "Summarize Queue",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Summarize Queue": {
        "main": [
          [
            {
              "node": "Done",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "pinData": {},
    "meta": {
      "templateCredsSetupCompleted": false
    }
  }
]
