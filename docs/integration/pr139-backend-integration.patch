+++ b/tests/dotActionSchemaGuard.pg.test.ts
@@ -0,0 +1,57 @@
+/**
+ * Prova comportamental (não apenas regex) de que os serviços de fila/auditoria
+ * do Dot NÃO executam DDL em caminho de requisição: com o schema incompleto,
+ * falham explicitamente e não recriam índice/coluna.
+ */
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { closeDB, getDb, initDB } from '../lib/db.js';
+import { listDotActions } from '../services/dotActionQueue.js';
+import { listDotActionAudit, recordDotActionAudit } from '../services/dotActionAudit.js';
+import { createTestDatabase, dropTestDatabase } from './helpers/pg-test-utils.js';
+
+test('serviços Dot não executam DDL quando o schema está incompleto', async () => {
+  const created = await createTestDatabase('pg_dot_schema_guard');
+  const previousUrl = process.env.DATABASE_URL;
+  process.env.DATABASE_URL = created.url;
+  try {
+    const db = await initDB();
+
+    // Índice único da fila ausente: listagem falha e não recria o índice.
+    await db.exec('DROP INDEX ux_dot_action_queue_decision_option');
+    await assert.rejects(
+      () => listDotActions('empresa-sem-schema'),
+      /ux_dot_action_queue_decision_option/i,
+    );
+    const index = await db.get(
+      "SELECT 1 AS ok FROM pg_indexes WHERE schemaname = 'public' AND indexname = 'ux_dot_action_queue_decision_option'",
+    );
+    assert.equal(index, undefined, 'serviço não pode recriar índice durante a requisição');
+
+    // Coluna metadata ausente: registro/consulta falham e não alteram a tabela.
+    await db.exec('ALTER TABLE dot_action_audit DROP COLUMN metadata');
+    await assert.rejects(
+      () => recordDotActionAudit({
+        empresaId: 'empresa-sem-schema',
+        actionId: 1,
+        event: 'prepared',
+        actorType: 'dot',
+      }),
+      /dot_action_audit\.metadata/i,
+    );
+    await assert.rejects(
+      () => listDotActionAudit('empresa-sem-schema', 1),
+      /dot_action_audit\.metadata/i,
+    );
+    const column = await db.get(
+      "SELECT 1 AS ok FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'dot_action_audit' AND column_name = 'metadata'",
+    );
+    assert.equal(column, undefined, 'serviço não pode recriar coluna durante a requisição');
+
+    await closeDB();
+  } finally {
+    await closeDB().catch(() => undefined);
+    process.env.DATABASE_URL = previousUrl;
+    await dropTestDatabase(created.name);
+  }
+});
diff --git a/tests/helpers/init-db-worker.pg.ts b/tests/helpers/init-db-worker.pg.ts
new file mode 100644
index 0000000..2713459
--- /dev/null
+++ b/tests/helpers/init-db-worker.pg.ts
@@ -0,0 +1,65 @@
+/**
+ * Worker de inicialização concorrente: roda `initDB()` em um processo Node
+ * isolado (pool próprio) e imprime um snapshot JSON do schema em stdout.
+ * Logs humanos vão para stderr para manter stdout parseável.
+ */
+import { initDB, closeDB, dbEngine } from '../../lib/db.js';
+import { indexExists, requireSchema, tableColumns } from '../../lib/migrations.js';
+
+process.env.NODE_ENV = 'test';
+console.log = (...args: unknown[]) => console.error(...args);
+
+const REQUIRED_INDEXES: Array<{ table: string; name: string }> = [
+  { table: 'reviews', name: 'idx_reviews_empresa' },
+  { table: 'empresas', name: 'idx_empresas_cnpj' },
+  { table: 'empresas', name: 'idx_empresas_slug' },
+  { table: 'usuarios', name: 'idx_usuarios_email' },
+  { table: 'password_resets', name: 'idx_password_resets_usuario' },
+  { table: 'dot_action_queue', name: 'ux_dot_action_queue_decision_option' },
+  { table: 'dot_action_queue', name: 'ux_dot_action_queue_one_active_decision' },
+  { table: 'dot_action_audit', name: 'idx_dot_action_audit_empresa' },
+  { table: 'dot_action_audit', name: 'idx_dot_action_audit_action' },
+];
+
+let exitCode = 0;
+try {
+  await initDB();
+  const { getDb } = await import('../../lib/db.js');
+  const db = getDb();
+  await requireSchema(db, {
+    tables: ['empresas', 'usuarios', 'reviews', 'ai_usage', 'usage', 'password_resets', 'dot_action_queue', 'dot_action_audit'],
+    columns: {
+      reviews: ['createdAt', 'is_test'],
+      usuarios: ['email', 'mfa_secret', 'mfa_enabled', 'mfa_backup_hashes', 'mfa_pending_secret'],
+      dot_action_audit: ['metadata'],
+    },
+    indexes: REQUIRED_INDEXES,
+  });
+
+  const version: any = await db.get('SHOW server_version').catch(() => undefined);
+  const indexSnapshot: Record<string, boolean> = {};
+  for (const index of REQUIRED_INDEXES) {
+    indexSnapshot[index.name] = await indexExists(db, index.table, index.name);
+  }
+
+  process.stdout.write(
+    JSON.stringify({
+      pid: process.pid,
+      engine: dbEngine(),
+      serverVersion: version?.server_version ?? null,
+      reviewsColumns: await tableColumns(db, 'reviews'),
+      usuariosColumns: await tableColumns(db, 'usuarios'),
+      auditColumns: await tableColumns(db, 'dot_action_audit'),
+      indexes: indexSnapshot,
+    }),
+  );
+} catch (error: any) {
+  console.error('init-db-worker falhou:', error?.stack || error);
+  exitCode = 1;
+} finally {
+  await closeDB().catch((error) => {
+    console.error('init-db-worker: closeDB falhou:', error);
+    exitCode = 1;
+  });
+}
+process.exitCode = exitCode;
diff --git a/tests/helpers/pg-test-utils.ts b/tests/helpers/pg-test-utils.ts
new file mode 100644
index 0000000..962b33c
--- /dev/null
+++ b/tests/helpers/pg-test-utils.ts
@@ -0,0 +1,131 @@
+/**
+ * Utilitários compartilhados pelos testes PostgreSQL reais (*.pg.test.ts).
+ * Nunca fazem parte de `npm test`: exigem DATABASE_URL apontando para um
+ * PostgreSQL descartável e criam/derrubam bancos temporários.
+ */
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import { spawn } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { Client } from 'pg';
+
+export type WorkerResult = {
+  code: number | null;
+  stdout: string;
+  stderr: string;
+  signal: NodeJS.Signals | null;
+  timedOut: boolean;
+};
+
+/** Erros de DDL/corrida que jamais podem aparecer em stderr. */
+export const DDL_ERROR_PATTERNS: RegExp[] = [
+  /already exists/i,
+  /\b42P07\b/,
+  /\b42701\b/,
+  /\b23505\b/,
+  /duplicate column/i,
+  /duplicate key value violates unique constraint/i,
+  /pg\.exec falhou/i,
+  /pg\.transaction: ROLLBACK falhou/i,
+  /advisory lock/i,
+];
+
+export function databaseUrl(): string {
+  const url = process.env.DATABASE_URL?.trim();
+  assert.ok(url, 'DATABASE_URL de teste PostgreSQL é obrigatória para testes *.pg.test.ts');
+  return url;
+}
+
+function postgresAdminUrl(): string {
+  const url = new URL(databaseUrl());
+  url.pathname = '/postgres';
+  return url.toString();
+}
+
+export async function withAdminClient<T>(work: (client: Client) => Promise<T>): Promise<T> {
+  const client = new Client({ connectionString: postgresAdminUrl() });
+  await client.connect();
+  try {
+    return await work(client);
+  } finally {
+    await client.end();
+  }
+}
+
+export async function createTestDatabase(prefix: string): Promise<{ name: string; url: string }> {
+  const name = `${prefix}_${Date.now()}_${crypto.randomBytes(4).toString('hex')}`.toLowerCase();
+  await withAdminClient(async (client) => {
+    await client.query(`CREATE DATABASE "${name}"`);
+  });
+  const url = new URL(databaseUrl());
+  url.pathname = `/${name}`;
+  return { name, url: url.toString() };
+}
+
+export async function dropTestDatabase(name: string): Promise<void> {
+  await withAdminClient(async (client) => {
+    await client.query(`DROP DATABASE IF EXISTS "${name}" WITH (FORCE)`);
+  });
+}
+
+export async function serverVersion(): Promise<string> {
+  return withAdminClient(async (client) => {
+    const result = await client.query('SHOW server_version');
+    return String(result.rows[0].server_version);
+  });
+}
+
+/**
+ * Executa um script Node/TS em processo filho, preservando stdout/stderr
+ * separados para inspeção (não basta olhar o exit code).
+ */
+export function runNodeScript(
+  scriptUrl: URL,
+  args: string[] = [],
+  env: NodeJS.ProcessEnv = {},
+  timeoutMs = 0,
+): Promise<WorkerResult> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(
+      process.execPath,
+      ['--import', 'tsx', fileURLToPath(scriptUrl), ...args],
+      {
+        cwd: process.cwd(),
+        env: { ...process.env, NODE_ENV: 'test', ...env },
+        stdio: ['ignore', 'pipe', 'pipe'],
+      },
+    );
+    let stdout = '';
+    let stderr = '';
+    let timedOut = false;
+    const timer = timeoutMs > 0
+      ? setTimeout(() => { timedOut = true; child.kill('SIGKILL'); }, timeoutMs)
+      : undefined;
+    child.stdout.setEncoding('utf8').on('data', (chunk) => { stdout += chunk; });
+    child.stderr.setEncoding('utf8').on('data', (chunk) => { stderr += chunk; });
+    child.on('error', reject);
+    child.on('close', (code, signal) => {
+      if (timer) clearTimeout(timer);
+      resolve({ code, stdout, stderr, signal, timedOut });
+    });
+  });
+}
+
+export function assertNoDdlErrors(stderr: string, label: string): void {
+  for (const pattern of DDL_ERROR_PATTERNS) {
+    assert.ok(
+      !pattern.test(stderr),
+      `${label}: stderr contém erro de DDL/corrida (${pattern}):\n${stderr}`,
+    );
+  }
+}
+
+export function parseWorkerJson<T>(result: WorkerResult, label: string): T {
+  assert.equal(result.code, 0, `${label}: processo terminou com código ${result.code} (sinal ${result.signal})\nstderr:\n${result.stderr}`);
+  assertNoDdlErrors(result.stderr, label);
+  try {
+    return JSON.parse(result.stdout) as T;
+  } catch (error) {
+    throw new Error(`${label}: stdout não é JSON (${String(error)}):\n${result.stdout}\nstderr:\n${result.stderr}`);
+  }
+}
diff --git a/tests/reviewsCentralSchema.pg.test.ts b/tests/reviewsCentralSchema.pg.test.ts
new file mode 100644
index 0000000..16d72b6
--- /dev/null
+++ b/tests/reviewsCentralSchema.pg.test.ts
@@ -0,0 +1,128 @@
+/**
+ * Banco legado PostgreSQL com apenas as colunas originais de `reviews`.
+ * A migração central deve adicionar todas as colunas usadas pela aplicação,
+ * com tipos compatíveis, preservando os dados e falhando explicitamente quando
+ * uma coluna obrigatória for removida.
+ */
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Client } from 'pg';
+import { closeDB, initDB } from '../lib/db.js';
+import { ensureReviewFraudColumns } from '../lib/reviewFraud.js';
+import { ensureSentimentColumns } from '../services/sentimentBackfill.js';
+import { ensureReviewTreatmentColumns } from '../lib/lgpd.js';
+import { REVIEW_COLUMNS, listIndexDefinitions, requireReviewSchema, tableColumnNames } from '../lib/migrations.js';
+import { createTestDatabase, dropTestDatabase } from './helpers/pg-test-utils.js';
+
+const EXPECTED_TYPES: Record<string, string> = {
+  createdat: 'timestamp with time zone',
+  is_test: 'integer',
+  ip_hash: 'text',
+  fraud_flags: 'text',
+  origin: 'text',
+  client_whatsapp: 'text',
+  sentiment: 'text',
+  sentiment_score: 'double precision',
+  sentiment_source: 'text',
+  locale: 'text',
+  unidade_id: 'text',
+  treated_at: 'timestamp with time zone',
+  treated_note: 'text',
+};
+
+test('PostgreSQL legado recebe todas as colunas de reviews sem perder dados', async () => {
+  const created = await createTestDatabase('pg_reviews_central');
+  const previousUrl = process.env.DATABASE_URL;
+  try {
+    const client = new Client({ connectionString: created.url });
+    await client.connect();
+    await client.query(`
+      CREATE TABLE reviews (
+        id SERIAL PRIMARY KEY,
+        empresa_id TEXT,
+        name TEXT,
+        rating INTEGER,
+        comment TEXT,
+        ai_reply TEXT,
+        ai_tags TEXT,
+        created_at TIMESTAMPTZ
+      )`);
+    await client.query(
+      `INSERT INTO reviews (id, empresa_id, name, rating, comment, created_at)
+       VALUES (1, 'empresa-legado', 'Cliente', 4, 'histórico', '2021-02-03T04:05:06Z')`,
+    );
+    await client.end();
+
+    process.env.DATABASE_URL = created.url;
+    const db = await initDB();
+
+    const columns = await tableColumnNames(db, 'reviews');
+    for (const column of REVIEW_COLUMNS) {
+      assert.ok(
+        columns.some((name) => name.toLowerCase() === column.toLowerCase()),
+        `coluna reviews.${column} ausente (${columns.join(',')})`,
+      );
+    }
+
+    const tipos = await db.all(
+      `SELECT column_name AS name, data_type AS type
+         FROM information_schema.columns
+        WHERE table_schema = 'public' AND table_name = 'reviews'`,
+    );
+    for (const [column, expected] of Object.entries(EXPECTED_TYPES)) {
+      const row: any = tipos.find((entry: any) => String(entry.name).toLowerCase() === column);
+      assert.ok(row, `coluna ${column} não encontrada em information_schema`);
+      assert.equal(String(row.type), expected, `tipo inesperado para reviews.${column}`);
+    }
+
+    const row: any = await db.get('SELECT createdAt, sentiment, treated_at FROM reviews WHERE id = 1');
+    assert.equal(new Date(String(row.createdat ?? row.createdAt)).toISOString(), '2021-02-03T04:05:06.000Z');
+    assert.equal(row.sentiment, null);
+    assert.equal(row.treated_at, null);
+
+    await requireReviewSchema(db);
+    await ensureReviewFraudColumns(db);
+    await ensureSentimentColumns(db);
+    await ensureReviewTreatmentColumns(db);
+
+    assert.equal((await listIndexDefinitions(db, ['reviews'])).some((index) => index.name === 'idx_reviews_empresa'), true);
+    await closeDB();
+  } finally {
+    await closeDB().catch(() => undefined);
+    process.env.DATABASE_URL = previousUrl;
+    await dropTestDatabase(created.name);
+  }
+});
+
+test('coluna obrigatória ausente falha explicitamente (sem DDL silenciosa)', async () => {
+  const created = await createTestDatabase('pg_reviews_missing');
+  const previousUrl = process.env.DATABASE_URL;
+  try {
+    process.env.DATABASE_URL = created.url;
+    const db = await initDB();
+
+    await db.exec('ALTER TABLE reviews DROP COLUMN locale');
+    await assert.rejects(
+      () => requireReviewSchema(db),
+      (error: any) => {
+        assert.match(String(error?.message || error), /Schema desatualizado/);
+        assert.match(String(error?.message || error), /reviews\.locale/i);
+        return true;
+      },
+      'requireReviewSchema deve falhar de forma explícita',
+    );
+
+    await db.exec('ALTER TABLE reviews DROP COLUMN fraud_flags');
+    await assert.rejects(() => ensureReviewFraudColumns(db), /reviews\.fraud_flags/i);
+    await db.exec('ALTER TABLE reviews DROP COLUMN sentiment_source');
+    await assert.rejects(() => ensureSentimentColumns(db), /reviews\.sentiment_source/i);
+
+    // Nenhuma tentativa automática de recriar a coluna.
+    assert.equal((await tableColumnNames(db, 'reviews')).includes('locale'), false);
+    await closeDB();
+  } finally {
+    await closeDB().catch(() => undefined);
+    process.env.DATABASE_URL = previousUrl;
+    await dropTestDatabase(created.name);
+  }
+});
diff --git a/tests/reviewsCentralSchema.test.ts b/tests/reviewsCentralSchema.test.ts
new file mode 100644
index 0000000..1ff18e4
--- /dev/null
+++ b/tests/reviewsCentralSchema.test.ts
@@ -0,0 +1,126 @@
+/**
+ * SQLite legado: a migração central precisa criar todas as colunas de reviews
+ * usadas pela aplicação, com tipos compatíveis, sem recriar a tabela nem
+ * perder dados históricos, e permanecer idempotente.
+ */
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { after, test } from 'node:test';
+import { fileURLToPath } from 'node:url';
+import { closeDB, getDb, initDB } from '../lib/db.js';
+import { REVIEW_COLUMNS, requireReviewSchema, tableColumnNames } from '../lib/migrations.js';
+
+const backendRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const dataDir = path.join(backendRoot, 'data');
+const files: string[] = [];
+
+async function createLegacy(): Promise<string> {
+  fs.mkdirSync(dataDir, { recursive: true });
+  const file = path.join(dataDir, `legacy-reviews-central-${Date.now()}-${Math.random().toString(16).slice(2)}.sqlite`);
+  files.push(file);
+  const { open } = await import('sqlite');
+  const sqlite3 = (await import('sqlite3')).default;
+  const db = await open({ filename: file, driver: sqlite3.Database });
+  try {
+    await db.exec(`CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      empresa_id TEXT,
+      name TEXT,
+      rating INTEGER,
+      comment TEXT,
+      ai_reply TEXT,
+      ai_tags TEXT,
+      created_at DATETIME
+    )`);
+    await db.run(
+      'INSERT INTO reviews (id, empresa_id, name, rating, comment, created_at) VALUES (?,?,?,?,?,?)',
+      [1, 'empresa-legado', 'Cliente', 4, 'histórico', '2021-02-03 04:05:06'],
+    );
+  } finally {
+    await db.close();
+  }
+  return file;
+}
+
+async function boot(file: string) {
+  await closeDB();
+  process.env.DATABASE_URL = '';
+  process.env.SQLITE_DB_PATH = file;
+  await initDB();
+  return getDb();
+}
+
+test('SQLite legado recebe todas as colunas de reviews e preserva dados', async () => {
+  const file = await createLegacy();
+  const db = await boot(file);
+
+  const columns = await tableColumnNames(db, 'reviews');
+  const lower = new Set(columns.map((name) => name.toLowerCase()));
+  for (const column of REVIEW_COLUMNS) {
+    assert.ok(lower.has(column.toLowerCase()), `coluna reviews.${column} ausente (${columns.join(',')})`);
+  }
+
+  const info: any[] = await db.all('PRAGMA table_info(reviews)');
+  const typeOf = (name: string) =>
+    String(info.find((row) => String(row.name).toLowerCase() === name)?.type || '').toUpperCase();
+  assert.equal(typeOf('is_test'), 'INTEGER');
+  assert.equal(typeOf('ip_hash'), 'TEXT');
+  assert.equal(typeOf('fraud_flags'), 'TEXT');
+  assert.equal(typeOf('origin'), 'TEXT');
+  assert.equal(typeOf('client_whatsapp'), 'TEXT');
+  assert.equal(typeOf('sentiment'), 'TEXT');
+  assert.equal(typeOf('sentiment_score'), 'REAL');
+  assert.equal(typeOf('sentiment_source'), 'TEXT');
+  assert.equal(typeOf('locale'), 'TEXT');
+  assert.equal(typeOf('unidade_id'), 'TEXT');
+  assert.equal(typeOf('treated_at'), 'TIMESTAMPTZ');
+  assert.equal(typeOf('treated_note'), 'TEXT');
+
+  const rows: any[] = await db.all('SELECT * FROM reviews ORDER BY id');
+  assert.equal(rows.length, 1);
+  assert.equal(String(rows[0].createdAt ?? rows[0].createdat), '2021-02-03 04:05:06');
+  assert.equal(rows[0].sentiment, null);
+  assert.equal(rows[0].treated_at, null);
+
+  await requireReviewSchema(db);
+
+  const before = await tableColumnNames(db, 'reviews');
+  const db2 = await boot(file);
+  const after = await tableColumnNames(db2, 'reviews');
+  assert.deepEqual(after, before, 'segunda inicialização não pode alterar as colunas');
+  const again: any[] = await db2.all('SELECT createdAt FROM reviews ORDER BY id');
+  assert.equal(String(again[0].createdAt), '2021-02-03 04:05:06');
+});
+
+after(async () => {
+  await closeDB();
+  for (const file of files) fs.rmSync(file, { force: true });
+});
+
+test('SQLite: falha na migração limpa o estado e permite nova inicialização', async () => {
+  fs.mkdirSync(dataDir, { recursive: true });
+  const file = path.join(dataDir, `legacy-reviews-failure-${Date.now()}.sqlite`);
+  files.push(file);
+  const { open } = await import('sqlite');
+  const sqlite3 = (await import('sqlite3')).default;
+  const setup = await open({ filename: file, driver: sqlite3.Database });
+  await setup.exec('CREATE VIEW reviews AS SELECT 1 AS id');
+  await setup.close();
+
+  await closeDB();
+  process.env.DATABASE_URL = '';
+  process.env.SQLITE_DB_PATH = file;
+  await assert.rejects(() => initDB(), /reviews|index|exist/i);
+  assert.throws(() => getDb(), /não inicializado/);
+
+  // Remove o bloqueio com uma conexão nova e tenta novamente.
+  const fix = await open({ filename: file, driver: sqlite3.Database });
+  await fix.exec('DROP VIEW reviews');
+  await fix.close();
+
+  const db = await initDB();
+  const columns = await tableColumnNames(db, 'reviews');
+  assert.ok(columns.some((name) => name.toLowerCase() === 'createdat'));
+  assert.ok(columns.includes('sentiment_score'));
+});
diff --git a/tests/reviewsCreatedAtHistory.pg.test.ts b/tests/reviewsCreatedAtHistory.pg.test.ts
new file mode 100644
index 0000000..28854c7
--- /dev/null
+++ b/tests/reviewsCreatedAtHistory.pg.test.ts
@@ -0,0 +1,191 @@
+/**
+ * Migração histórica de `reviews.createdAt` no PostgreSQL.
+ *
+ * Variantes reais:
+ * - `createdat` — nome gerado pela DDL original (`createdAt` sem aspas);
+ * - `created_at` — schemas antigos em snake_case;
+ * - `"createdAt"` — coluna criada com aspas por outra ferramenta.
+ *
+ * A migração precisa preservar os valores históricos, não preencher lacunas
+ * com `NOW()` e manter as consultas `createdAt` da aplicação funcionando.
+ */
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Client } from 'pg';
+import { closeDB, getDb, initDB } from '../lib/db.js';
+import { tableColumnNames } from '../lib/migrations.js';
+import { createTestDatabase, dropTestDatabase } from './helpers/pg-test-utils.js';
+
+async function withClient<T>(url: string, work: (client: Client) => Promise<T>): Promise<T> {
+  const client = new Client({ connectionString: url });
+  await client.connect();
+  try {
+    return await work(client);
+  } finally {
+    await client.end();
+  }
+}
+
+async function boot(url: string) {
+  await closeDB();
+  process.env.DATABASE_URL = url;
+  await initDB();
+  return getDb();
+}
+
+function iso(value: unknown): string {
+  return new Date(String(value)).toISOString();
+}
+
+// O adapter do backend reescreve `createdAt` para `"createdAt"`; a coluna
+// canônica é exatamente essa e as fontes históricas seguem intactas.
+function canonicalDate(row: any): unknown {
+  return row.createdat ?? row.createdAt ?? row.created_at;
+}
+
+test('PostgreSQL: created_at histórico é copiado para createdat sem perder datas', async () => {
+  const created = await createTestDatabase('pg_reviews_created_at');
+  const previousUrl = process.env.DATABASE_URL;
+  try {
+    await withClient(created.url, async (client) => {
+      await client.query(`
+        CREATE TABLE reviews (
+          id SERIAL PRIMARY KEY,
+          empresa_id TEXT,
+          name TEXT,
+          rating INTEGER,
+          comment TEXT,
+          ai_reply TEXT,
+          ai_tags TEXT,
+          created_at TIMESTAMPTZ
+        )`);
+      await client.query(
+        `INSERT INTO reviews (id, empresa_id, name, rating, comment, created_at) VALUES
+          (1, 'empresa-historica', 'Antigo', 5, 'antigo', '2020-05-06T07:08:09Z'),
+          (2, 'empresa-historica', 'Recente', 2, 'recente', '2023-11-12T13:14:15Z'),
+          (3, 'empresa-historica', 'Sem data', 4, 'sem data', NULL)`,
+      );
+      // Mantém a sequência SERIAL coerente com os IDs históricos inseridos.
+      await client.query(`SELECT setval(pg_get_serial_sequence('reviews', 'id'), 3, true)`);
+    });
+
+    const db = await boot(created.url);
+    const columns = await tableColumnNames(db, 'reviews');
+    assert.ok(columns.includes('createdAt'), `coluna canônica createdAt ausente: ${columns.join(',')}`);
+    assert.ok(columns.includes('created_at'), 'coluna histórica não pode ser removida');
+
+    const rows = await db.all('SELECT id, createdAt, created_at FROM reviews ORDER BY id');
+    assert.equal(rows.length, 3);
+    assert.equal(iso(canonicalDate(rows[0])), '2020-05-06T07:08:09.000Z');
