new file mode 100644
index 0000000..0b99531
--- /dev/null
+++ b/tests/dbIndexSnapshot.pg.test.ts
@@ -0,0 +1,56 @@
+/**
+ * Snapshot real de índices (pg_indexes): nome, tabela e definição.
+ * Deve detectar índice ausente e definição alterada (inclusive único/parcial).
+ */
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { initPgDatabase } from '../lib/db.pg.js';
+import { listIndexDefinitions, runCentralMigrations } from '../lib/migrations.js';
+import { createTestDatabase, dropTestDatabase } from './helpers/pg-test-utils.js';
+
+const TABLES = ['empresas', 'usuarios', 'reviews', 'password_resets', 'dot_action_queue', 'dot_action_audit'];
+
+test('snapshot de índices captura definições reais e detecta ausência/alteração', async () => {
+  const created = await createTestDatabase('pg_index_snapshot');
+  const db = await initPgDatabase(created.url);
+  try {
+    await runCentralMigrations(db);
+    const baseline = await listIndexDefinitions(db, TABLES);
+    assert.ok(baseline.length > 0);
+    for (const index of baseline) {
+      assert.ok(index.name.length > 0);
+      assert.ok(TABLES.includes(index.table));
+      assert.match(index.definition, /^CREATE (UNIQUE )?INDEX /, `definição inválida: ${index.definition}`);
+    }
+
+    const unique = baseline.find((index) => index.name === 'idx_usuarios_email');
+    assert.equal(unique?.unique, true, 'índice único deve ser identificado pela definição real');
+    const partial = baseline.find((index) => index.name === 'ux_dot_action_queue_one_active_decision');
+    assert.equal(partial?.unique, true);
+    assert.match(String(partial?.definition), /WHERE/i, 'índice parcial deve manter o predicado na definição');
+
+    // Ausência detectada.
+    await db.exec('DROP INDEX idx_dot_action_audit_empresa');
+    const semIndice = await listIndexDefinitions(db, TABLES);
+    assert.equal(semIndice.some((index) => index.name === 'idx_dot_action_audit_empresa'), false);
+    assert.notDeepEqual(semIndice, baseline, 'snapshot deve mudar quando um índice desaparece');
+
+    // Definição alterada detectada.
+    await db.exec('CREATE INDEX idx_dot_action_audit_empresa ON dot_action_audit(created_at)');
+    const alterado = await listIndexDefinitions(db, TABLES);
+    const original = baseline.find((index) => index.name === 'idx_dot_action_audit_empresa');
+    const diferente = alterado.find((index) => index.name === 'idx_dot_action_audit_empresa');
+    assert.ok(original && diferente);
+    assert.notEqual(diferente?.definition, original?.definition, 'definição diferente deve ser detectada');
+    assert.notDeepEqual(alterado, baseline);
+
+    // Migração restaura a definição canônica quando o índice está ausente.
+    await db.exec('DROP INDEX idx_dot_action_audit_empresa');
+    await runCentralMigrations(db);
+    const restaurado = await listIndexDefinitions(db, TABLES);
+    assert.deepEqual(restaurado, baseline, 'segunda inicialização deve restaurar exatamente as definições');
+  } finally {
+    await db.close();
+    await dropTestDatabase(created.name);
+  }
+});
diff --git a/tests/dbInitFailureRecovery.pg.test.ts b/tests/dbInitFailureRecovery.pg.test.ts
new file mode 100644
index 0000000..48206bb
--- /dev/null
+++ b/tests/dbInitFailureRecovery.pg.test.ts
@@ -0,0 +1,117 @@
+/**
+ * initDB() deve ser atômico: se a conexão abre mas a migração falha, fecha a
+ * instância criada, limpa o estado, propaga o erro original e permite nova
+ * tentativa. Uma instância anterior (de outra chamada) nunca é fechada.
+ */
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Client } from 'pg';
+import { closeDB, getDb, initDB } from '../lib/db.js';
+import { tableColumns } from '../lib/migrations.js';
+import {
+  createTestDatabase,
+  dropTestDatabase,
+  withAdminClient,
+} from './helpers/pg-test-utils.js';
+
+async function withRaw(url: string, sql: string): Promise<void> {
+  const client = new Client({ connectionString: url });
+  await client.connect();
+  try {
+    await client.query(sql);
+  } finally {
+    await client.end();
+  }
+}
+
+async function connectionsFor(database: string): Promise<number> {
+  return withAdminClient(async (client) => {
+    const result = await client.query(
+      'SELECT count(*)::int AS c FROM pg_stat_activity WHERE datname = $1',
+      [database],
+    );
+    return Number(result.rows[0].c);
+  });
+}
+
+async function waitForNoConnections(database: string): Promise<number> {
+  const deadline = Date.now() + 5_000;
+  let count = await connectionsFor(database);
+  while (count !== 0 && Date.now() < deadline) {
+    await new Promise((resolve) => setTimeout(resolve, 100));
+    count = await connectionsFor(database);
+  }
+  return count;
+}
+
+test('falha na migração de initDB fecha o pool, propaga o erro e permite nova tentativa', async () => {
+  const created = await createTestDatabase('pg_init_failure_recovery');
+  const previousUrl = process.env.DATABASE_URL;
+  process.env.DATABASE_URL = created.url;
+  try {
+    // Bloqueia a tabela reviews com uma view: a migração falha de verdade.
+    await withRaw(created.url, 'CREATE VIEW reviews AS SELECT 1 AS id');
+
+    await assert.rejects(
+      () => initDB(),
+      (error: any) => {
+        assert.match(String(error?.message || error), /reviews|relation|index/i);
+        console.log('erro original propagado:', error?.message, 'code=', error?.code);
+        return true;
+      },
+      'initDB deve rejeitar quando a migração falha',
+    );
+
+    // Estado limpo: nenhum banco ativo e nenhuma conexão pendurada.
+    assert.throws(() => getDb(), /não inicializado/, 'getDb não pode devolver instância após falha');
+    const remaining = await waitForNoConnections(created.name);
+    assert.equal(remaining, 0, `pool deveria estar fechado, mas há ${remaining} conexão(ões)`);
+
+    // Corrige o schema e tenta novamente: recuperação completa.
+    await withRaw(created.url, 'DROP VIEW reviews');
+    const db = await initDB();
+    const columns = await tableColumns(db, 'reviews');
+    for (const column of ['createdat', 'is_test', 'ip_hash', 'sentiment_score', 'treated_at']) {
+      assert.ok(columns.includes(column), `recuperação deve criar reviews.${column}`);
+    }
+    await closeDB();
+  } finally {
+    await closeDB().catch(() => undefined);
+    process.env.DATABASE_URL = previousUrl;
+    await dropTestDatabase(created.name);
+  }
+});
+
+test('falha de uma nova initDB não fecha a instância de uma chamada anterior', async () => {
+  const good = await createTestDatabase('pg_init_keep_previous');
+  const bad = await createTestDatabase('pg_init_new_failure');
+  const previousUrl = process.env.DATABASE_URL;
+  try {
+    process.env.DATABASE_URL = good.url;
+    const first = await initDB();
+    await first.run('INSERT INTO empresas (id, cnpj, nome_empresa, criado_em, expira_em) VALUES (?,?,?,?,?)', [
+      'empresa-keep',
+      '12345678000199',
+      'Empresa Keep',
+      new Date().toISOString(),
+      new Date(Date.now() + 86400000).toISOString(),
+    ]);
+
+    await withRaw(bad.url, 'CREATE VIEW reviews AS SELECT 1 AS id');
+    process.env.DATABASE_URL = bad.url;
+    await assert.rejects(() => initDB(), /reviews|relation|index/i);
+
+    // A instância anterior continua ativa e utilizável.
+    assert.equal(getDb(), first, 'getDb deve continuar apontando para a instância anterior');
+    const row = await getDb().get('SELECT nome_empresa FROM empresas WHERE id = ?', ['empresa-keep']);
+    assert.equal(String(row?.nome_empresa), 'Empresa Keep');
+    assert.equal(await waitForNoConnections(bad.name), 0, 'a instância que falhou não pode manter pool aberto');
+
+    await closeDB();
+  } finally {
+    await closeDB().catch(() => undefined);
+    process.env.DATABASE_URL = previousUrl;
+    await dropTestDatabase(good.name);
+    await dropTestDatabase(bad.name);
+  }
+});
diff --git a/tests/dbInitializationConcurrency.pg.test.ts b/tests/dbInitializationConcurrency.pg.test.ts
