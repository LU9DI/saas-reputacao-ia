index 0000000..6e1cd36
--- /dev/null
+++ b/tests/dbInitializationConcurrency.pg.test.ts
@@ -0,0 +1,237 @@
+/**
+ * Teste real de inicialização concorrente em PostgreSQL descartável.
+ *
+ * Cenário: banco vazio + 3 processos Node independentes chamando `initDB()`
+ * ao mesmo tempo. Valida que o advisory lock global serializa as migrações,
+ * que nenhum processo falha, que nenhum DDL concorrente vaza para stderr e
+ * que uma segunda inicialização é idempotente.
+ */
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Client } from 'pg';
+import { closeDB, getDb, initDB } from '../lib/db.js';
+import { initPgDatabase } from '../lib/db.pg.js';
+import {
+  PG_MIGRATION_LOCK_KEY,
+  indexExists,
+  REVIEW_COLUMNS,
+  listIndexDefinitions,
+  runCentralMigrations,
+  tableColumns,
+  tableExists,
+} from '../lib/migrations.js';
+import {
+  assertNoDdlErrors,
+  createTestDatabase,
+  dropTestDatabase,
+  parseWorkerJson,
+  runNodeScript,
+  serverVersion,
+} from './helpers/pg-test-utils.js';
+
+const INIT_WORKER = new URL('./helpers/init-db-worker.pg.ts', import.meta.url);
+
+const REQUIRED_INDEXES = [
+  'idx_reviews_empresa',
+  'idx_empresas_cnpj',
+  'idx_empresas_slug',
+  'idx_usuarios_email',
+  'idx_password_resets_usuario',
+  'ux_dot_action_queue_decision_option',
+  'ux_dot_action_queue_one_active_decision',
+  'idx_dot_action_audit_empresa',
+  'idx_dot_action_audit_action',
+];
+
+async function assertRequiredSchema(db: any, label: string) {
+  for (const table of ['empresas', 'usuarios', 'reviews', 'ai_usage', 'usage', 'password_resets', 'dot_action_queue', 'dot_action_audit']) {
+    assert.equal(await tableExists(db, table), true, `${label}: tabela ${table} deve existir`);
+  }
+
+  const reviewColumns = await tableColumns(db, 'reviews');
+  for (const column of REVIEW_COLUMNS) {
+    assert.equal(reviewColumns.includes(column.toLowerCase()), true, `${label}: reviews.${column} ausente (${reviewColumns.join(',')})`);
+  }
+
+  const userColumns = await tableColumns(db, 'usuarios');
+  for (const column of ['email', 'mfa_secret', 'mfa_enabled', 'mfa_backup_hashes', 'mfa_pending_secret']) {
+    assert.equal(userColumns.includes(column), true, `${label}: usuarios.${column} ausente (${userColumns.join(',')})`);
+  }
+
+  const auditColumns = await tableColumns(db, 'dot_action_audit');
+  assert.equal(auditColumns.includes('metadata'), true, `${label}: dot_action_audit.metadata ausente`);
+
+  const indexTables: Record<string, string> = {
+    idx_reviews_empresa: 'reviews',
+    idx_empresas_cnpj: 'empresas',
+    idx_empresas_slug: 'empresas',
+    idx_usuarios_email: 'usuarios',
+    idx_password_resets_usuario: 'password_resets',
+    ux_dot_action_queue_decision_option: 'dot_action_queue',
+    ux_dot_action_queue_one_active_decision: 'dot_action_queue',
+    idx_dot_action_audit_empresa: 'dot_action_audit',
+    idx_dot_action_audit_action: 'dot_action_audit',
+  };
+  for (const index of REQUIRED_INDEXES) {
+    assert.equal(await indexExists(db, indexTables[index], index), true, `${label}: índice ${index} ausente`);
+  }
+}
+
+const SNAPSHOT_TABLES = [
+  'empresas',
+  'usuarios',
+  'reviews',
+  'password_resets',
+  'dot_action_queue',
+  'dot_action_audit',
+];
+
+/** Snapshot real: colunas + definições de índices (pg_indexes), sem placeholders. */
+async function snapshot(db: any) {
+  return {
+    reviews: await tableColumns(db, 'reviews'),
+    usuarios: await tableColumns(db, 'usuarios'),
+    audit: await tableColumns(db, 'dot_action_audit'),
+    indexes: await listIndexDefinitions(db, SNAPSHOT_TABLES),
+  };
+}
+
+test('três processos inicializam um banco PostgreSQL vazio simultaneamente sem erro de DDL', async () => {
+  const version = await serverVersion();
+  console.log(`PostgreSQL real em uso: ${version}`);
+  assert.ok(Number(version.split('.')[0]) >= 16, `PostgreSQL >= 16 esperado, recebido ${version}`);
+
+  const { name, url } = await createTestDatabase('pg_init_concurrent');
+  const previousUrl = process.env.DATABASE_URL;
+  try {
+    process.env.DATABASE_URL = url;
+
+    // Banco começa vazio: nenhuma tabela pré-existente.
+    const probe = await initPgDatabase(url);
+    assert.equal(await tableExists(probe, 'reviews'), false, 'o banco de teste deve começar vazio');
+
+    // Três processos independentes, cada um com seu próprio pool, partindo juntos.
+    const results = await Promise.all([
+      runNodeScript(INIT_WORKER, [], { DATABASE_URL: url }),
+      runNodeScript(INIT_WORKER, [], { DATABASE_URL: url }),
+      runNodeScript(INIT_WORKER, [], { DATABASE_URL: url }),
+    ]);
+
+    for (const [index, result] of results.entries()) {
+      console.log(`worker ${index + 1}: exit=${result.code} stdout=${result.stdout} stderr=${result.stderr.trim()}`);
+      assert.equal(result.code, 0, `worker ${index + 1} falhou com código ${result.code}\nstderr:\n${result.stderr}`);
+      assertNoDdlErrors(result.stderr, `worker ${index + 1}`);
+    }
+
+    const payloads = results.map((result, index) => parseWorkerJson<any>(result, `worker ${index + 1}`));
+    const pids = new Set(payloads.map((payload) => payload.pid));
+    assert.equal(pids.size, 3, 'cada worker deve rodar em um processo Node próprio');
+    for (const payload of payloads) {
+      assert.equal(payload.engine, 'postgres');
+      assert.ok(payload.serverVersion?.startsWith('16.'), `worker deve falar com PostgreSQL 16, recebeu ${payload.serverVersion}`);
+      assert.ok(payload.indexes.idx_dot_action_audit_action, 'worker deve enxergar os índices de auditoria');
+      for (const column of REVIEW_COLUMNS) {
+        assert.equal(
+          payload.reviewsColumns.includes(column.toLowerCase()),
+          true,
+          `worker não enxerga reviews.${column}: ${payload.reviewsColumns.join(',')}`,
+        );
+      }
+    }
+
+    // Conferência independente (pool do processo de teste).
+    await assertRequiredSchema(probe, 'após inicialização concorrente');
+    const firstSnapshot = await snapshot(probe);
+    assert.equal(firstSnapshot.indexes.length > 0, true, 'snapshot deve conter índices reais');
+    for (const required of REQUIRED_INDEXES) {
+      const entry = firstSnapshot.indexes.find((index: any) => index.name === required);
+      assert.ok(entry, `snapshot sem o índice ${required}`);
+      assert.ok(entry.definition.includes(`INDEX ${required}`), 'definição real do índice deve ser capturada');
+    }
+    const partial = firstSnapshot.indexes.find((index: any) => index.name === 'ux_dot_action_queue_one_active_decision');
+    assert.equal(partial?.unique, true, 'índice parcial deve ser único');
+    assert.match(String(partial?.definition), /WHERE/i, 'definição do índice parcial deve aparecer no snapshot');
+
+    // Segunda inicialização no mesmo banco: comprova idempotência.
+    await runCentralMigrations(probe);
+    await assertRequiredSchema(probe, 'segunda inicialização');
+    const secondSnapshot = await snapshot(probe);
+    assert.deepEqual(secondSnapshot, firstSnapshot, 'segunda inicialização não pode alterar o schema');
+    console.log('idempotência comprovada: schema idêntico após segunda inicialização');
+
+    // `initDB()` global também deve ser idempotente.
+    await initDB();
+    await assertRequiredSchema(getDb(), 'initDB() repetido');
+    await probe.close();
+    await closeDB();
+  } finally {
+    process.env.DATABASE_URL = previousUrl;
+    await dropTestDatabase(name);
+  }
+});
+
+test('falha deliberada de migração é propagada e o advisory lock é liberado', async () => {
+  const { name, url } = await createTestDatabase('pg_init_failure');
+  try {
+    // Impede a criação de `reviews`: um objeto com o mesmo nome já existe.
+    const blocker = new Client({ connectionString: url });
+    await blocker.connect();
+    await blocker.query('CREATE VIEW reviews AS SELECT 1 AS id');
+    await blocker.end();
+
+    const db = await initPgDatabase(url);
+    try {
+      await assert.rejects(
+        () => runCentralMigrations(db),
+        (error: any) => {
+          console.log('erro propagado como esperado:', error?.message);
+          return /reviews|exist|relation/i.test(String(error?.message || error));
+        },
+        'migração quebrada deve rejeitar a inicialização',
+      );
+    } finally {
+      await db.close();
+    }
+
+    // O lock não pode ficar preso após a falha.
+    const checker = new Client({ connectionString: url });
+    await checker.connect();
+    const lock = await checker.query('SELECT pg_try_advisory_lock($1) AS locked', [PG_MIGRATION_LOCK_KEY.toString()]);
+    assert.equal(lock.rows[0].locked, true, 'advisory lock deve ter sido liberado no finally');
+    await checker.query('SELECT pg_advisory_unlock($1)', [PG_MIGRATION_LOCK_KEY.toString()]);
+    await checker.end();
+  } finally {
+    await dropTestDatabase(name);
+  }
+});
+
+test('três processos com PG_POOL_MAX=1 inicializam o mesmo banco sem deadlock', async () => {
+  const { name, url } = await createTestDatabase('pg_init_pool_one');
+  const previousUrl = process.env.DATABASE_URL;
+  try {
+    process.env.DATABASE_URL = url;
+    const results = await Promise.all([
+      runNodeScript(INIT_WORKER, [], { DATABASE_URL: url, PG_POOL_MAX: '1' }, 60_000),
+      runNodeScript(INIT_WORKER, [], { DATABASE_URL: url, PG_POOL_MAX: '1' }, 60_000),
+      runNodeScript(INIT_WORKER, [], { DATABASE_URL: url, PG_POOL_MAX: '1' }, 60_000),
+    ]);
+
+    for (const [index, result] of results.entries()) {
+      assert.equal(result.timedOut, false, `worker ${index + 1} entrou em deadlock com PG_POOL_MAX=1`);
+      console.log(`worker PG_POOL_MAX=1 ${index + 1}: exit=${result.code} stderr=${result.stderr.trim()}`);
+      assert.equal(result.code, 0, `worker ${index + 1} falhou\nstderr:\n${result.stderr}`);
+      assertNoDdlErrors(result.stderr, `worker PG_POOL_MAX=1 ${index + 1}`);
+      parseWorkerJson<any>(result, `worker PG_POOL_MAX=1 ${index + 1}`);
+    }
+
+    const probe = await initPgDatabase(url);
+    try {
+      await assertRequiredSchema(probe, 'após inicialização com PG_POOL_MAX=1');
+    } finally {
+      await probe.close();
+    }
+  } finally {
+    process.env.DATABASE_URL = previousUrl;
+    await dropTestDatabase(name);
+  }
+});
diff --git a/tests/dbInstances.pg.test.ts b/tests/dbInstances.pg.test.ts
new file mode 100644
index 0000000..c2daa29
--- /dev/null
+++ b/tests/dbInstances.pg.test.ts
@@ -0,0 +1,79 @@
+/**
+ * Isolamento de pools: cada `initPgDatabase` captura o próprio `pg.Pool`.
+ * Fechar (ou inicializar) uma instância não pode encerrar/alterar as conexões
+ * de outra instância já existente.
+ */
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { initPgDatabase } from '../lib/db.pg.js';
+import { createTestDatabase, dropTestDatabase } from './helpers/pg-test-utils.js';
+
+test('fechar uma instância PostgreSQL não encerra a outra', async () => {
+  const a = await createTestDatabase('pg_instance_a');
+  const b = await createTestDatabase('pg_instance_b');
+  try {
+    const first = await initPgDatabase(a.url);
+    const second = await initPgDatabase(b.url);
+
+    await first.exec('CREATE TABLE instancia_a (id INTEGER PRIMARY KEY AUTOINCREMENT, nome TEXT)');
+    await second.exec('CREATE TABLE instancia_b (id INTEGER PRIMARY KEY AUTOINCREMENT, nome TEXT)');
+
+    // Inicializar/`fechar` um terceiro banco não pode tocar nas instâncias vivas.
+    const third = await initPgDatabase(a.url);
+    await third.exec('CREATE TABLE instancia_c (id INTEGER PRIMARY KEY AUTOINCREMENT)');
+    await third.close();
+
+    // `second` segue funcionando após fechar a outra instância do banco A.
+    await first.close();
+
+    const stillAlive = await second.get<{ ok: number }>('SELECT 1 AS ok');
+    assert.equal(stillAlive?.ok, 1, 'a instância B deve continuar respondendo após B fechar A');
+    await second.run('INSERT INTO instancia_b (nome) VALUES (?)', ['viva']);
+    const rows = await second.all<{ nome: string }>('SELECT nome FROM instancia_b');
+    assert.equal(rows.length, 1, 'a instância B deve continuar aceitando escritas');
+
+    // A instância fechada não pode mais ser usada (seu pool foi encerrado).
+    await assert.rejects(
+      () => first.get('SELECT 1 AS ok'),
+      /pool|closed|encerrad|Cannot use a pool/i,
+      'a instância fechada deve rejeitar novas operações',
+    );
+
+    await second.close();
+    await assert.rejects(
+      () => second.get('SELECT 1 AS ok'),
+      /pool|closed|encerrad|Cannot use a pool/i,
+      'a segunda instância também deve encerrar apenas o próprio pool',
+    );
+  } finally {
+    await dropTestDatabase(a.name);
+    await dropTestDatabase(b.name);
+  }
+});
+
+test('exec propaga erros inesperados de catálogo em vez de mascará-los', async () => {
+  const created = await createTestDatabase('pg_exec_errors');
+  const db = await initPgDatabase(created.url);
+  try {
+    await db.exec('CREATE TABLE alvo (id INTEGER PRIMARY KEY AUTOINCREMENT, nome TEXT)');
+
+    // 42P07 duplicate_table não pode ser engolido.
+    await assert.rejects(() => db.exec('CREATE TABLE alvo (id INTEGER)'), /already exists|42P07/i);
+    // 42701 duplicate_column não pode ser engolido.
+    await assert.rejects(() => db.exec('ALTER TABLE alvo ADD COLUMN id TEXT'), /already exists|duplicate column|42701/i);
+    // 42P01 undefined_table precisa propagar.
+    await assert.rejects(
+      () => db.exec('ALTER TABLE tabela_inexistente ADD COLUMN a TEXT'),
+      /does not exist|42P01/i,
+    );
+    // 42601 syntax error precisa propagar.
+    await assert.rejects(() => db.exec('SELEC 1'), /syntax|42601/i);
+
+    // IF NOT EXISTS continua idempotente quando usado de forma explícita.
+    await db.exec('CREATE TABLE IF NOT EXISTS alvo (id INTEGER)');
+    await db.exec('CREATE INDEX IF NOT EXISTS idx_alvo_nome ON alvo(nome)');
+  } finally {
+    await db.close();
+    await dropTestDatabase(created.name);
+  }
+});
diff --git a/tests/dbMigrationsGuards.test.ts b/tests/dbMigrationsGuards.test.ts
new file mode 100644
index 0000000..a9e352f
--- /dev/null
+++ b/tests/dbMigrationsGuards.test.ts
@@ -0,0 +1,118 @@
+/**
+ * Guardas de arquitetura das migrações (sem banco):
+ * - caminhos de requisição não executam DDL;
+ * - `requireSchema` apenas verifica, nunca corrige;
+ * - o adapter PostgreSQL não mantém pool global mutável;
+ * - a chave do advisory lock é estável.
+ */
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { test } from 'node:test';
+import type { Database } from 'sqlite';
+import { PG_MIGRATION_LOCK_KEY, requireReviewSchema, requireSchema } from '../lib/migrations.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const backendRoot = path.resolve(__dirname, '..');
+
+function source(relative: string): string {
+  return fs.readFileSync(path.join(backendRoot, relative), 'utf8');
+}
+
+function fakeDb(
+  tables: Record<string, string[]>,
+  indexes: string[] = [],
+): { db: Database; execCalls: string[] } {
+  const execCalls: string[] = [];
+  const db = {
+    async all(sql: string) {
+      const pragma = /PRAGMA\s+table_info\(\s*([\w]+)\s*\)/i.exec(sql);
+      if (pragma) return (tables[pragma[1]] || []).map((name) => ({ name }));
+      if (/PRAGMA\s+index_list/i.test(sql)) return indexes.map((name) => ({ name }));
+      return [];
+    },
+    async get(sql: string, params: any[] = []) {
+      if (/pg_indexes/i.test(sql)) return indexes.includes(String(params[0])) ? { ok: 1 } : undefined;
+      return undefined;
+    },
+    async exec(sql: string) {
+      execCalls.push(sql);
+    },
+  } as unknown as Database;
+  return { db, execCalls };
+}
+
+test('requireSchema valida sem executar DDL quando o schema está completo', async () => {
+  const { db, execCalls } = fakeDb(
+    { usuarios: ['id', 'email', 'mfa_secret', 'mfa_enabled', 'mfa_backup_hashes', 'mfa_pending_secret'] },
+    ['idx_usuarios_email'],
+  );
+  await requireSchema(db, {
+    tables: ['usuarios'],
+    columns: { usuarios: ['email', 'mfa_secret', 'mfa_enabled', 'mfa_backup_hashes', 'mfa_pending_secret'] },
+    indexes: [{ table: 'usuarios', name: 'idx_usuarios_email' }],
+  });
+  assert.deepEqual(execCalls, [], 'verificação de schema não pode executar DDL');
+});
+
+test('requireSchema falha explicitamente quando uma estrutura obrigatória está ausente', async () => {
+  const { db, execCalls } = fakeDb({ usuarios: ['id'] }, []);
+  await assert.rejects(
+    () => requireSchema(db, { columns: { usuarios: ['email'] }, tables: ['password_resets'] }),
+    (error: any) => {
+      const message = String(error?.message || error);
+      assert.match(message, /Schema desatualizado/);
+      assert.match(message, /usuarios\.email/);
+      assert.match(message, /password_resets/);
+      return true;
+    },
+  );
+  assert.deepEqual(execCalls, [], 'falha de verificação não pode tentar corrigir o schema');
+});
+
+test('caminhos de requisição não contêm DDL', () => {
+  const files = [
+    'passwordResetRoutes.ts',
+    'mfa.ts',
+    'services/dotActionAudit.ts',
+    'services/dotActionQueue.ts',
+    'services/reviewService.ts',
+    'services/sentimentBackfill.ts',
+    'lib/reviewFraud.ts',
+    'lib/lgpd.ts',
+    'routes/empresaRoutes.ts',
+    'routes/adminTecnicoRoutes.ts',
+  ];
+  const ddl = /\b(ALTER\s+TABLE\s+reviews|CREATE\s+TABLE\s+(?:IF\s+NOT\s+EXISTS\s+)?reviews|CREATE\s+(?:UNIQUE\s+)?INDEX\s+\w+\s+ON\s+reviews)\b/i;
+  for (const file of files) {
+    assert.equal(ddl.test(source(file)), false, `${file} não pode executar DDL em caminho de requisição`);
+  }
+});
+
+test('adapter PostgreSQL não usa pool global mutável e expõe o lock de migração', () => {
+  const src = source('lib/db.pg.ts');
+  assert.equal(/^\s*let\s+pool\b/m.test(src), false, 'lib/db.pg.ts não pode ter pool global mutável');
+  assert.match(src, /withMigrationLock/);
+  assert.match(src, /pg_advisory_lock/);
+  assert.match(src, /pg_advisory_unlock/);
+  // Tolerância só é permitida para DDL com IF NOT EXISTS (corrida de catálogo).
+  assert.match(src, /isIdempotentDdlRace/);
+  assert.match(src, /IF\\s\+NOT\\s\+EXISTS/);
+  assert.doesNotMatch(src, /if \(\s*\/already exists\/i\.test\(msg\)\s*\)\s*\{\s*continue;/);
+});
+
+test('requireReviewSchema falha explicitamente e não executa DDL', async () => {
+  const { db, execCalls } = fakeDb({ reviews: ['id', 'created_at', 'is_test', 'ip_hash'] }, []);
+  await assert.rejects(
+    () => requireReviewSchema(db),
+    (error: any) => /reviews\.(fraud_flags|origin|client_whatsapp|sentiment|locale)/.test(String(error?.message || error)),
+  );
+  assert.deepEqual(execCalls, [], 'verificação de reviews não pode executar DDL');
+});
+
+test('chave do advisory lock de migração é estável e positiva (int8)', () => {
+  assert.equal(PG_MIGRATION_LOCK_KEY, 8005998760133593297n);
+  assert.ok(PG_MIGRATION_LOCK_KEY > 0n);
+  assert.ok(PG_MIGRATION_LOCK_KEY <= 9223372036854775807n, 'precisa caber em int8 assinado');
+});
diff --git a/tests/dbPoolMaxOne.pg.test.ts b/tests/dbPoolMaxOne.pg.test.ts
new file mode 100644
index 0000000..f76deb7
--- /dev/null
+++ b/tests/dbPoolMaxOne.pg.test.ts
@@ -0,0 +1,54 @@
+/**
+ * Regressão de deadlock: as migrações rodam NA conexão dedicada que mantém o
+ * advisory lock, então `PG_POOL_MAX=1` é suficiente. Se a implementação
+ * tentasse pegar uma segunda conexão do pool, este teste travaria.
+ */
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { initPgDatabase } from '../lib/db.pg.js';
+import { runCentralMigrations } from '../lib/migrations.js';
+import { createTestDatabase, dropTestDatabase } from './helpers/pg-test-utils.js';
+
+const MIGRATION_TIMEOUT_MS = 20_000;
+
+test('PG_POOL_MAX=1 conclui migrações sem deadlock e libera a conexão', async () => {
+  const previousMax = process.env.PG_POOL_MAX;
+  process.env.PG_POOL_MAX = '1';
+  const created = await createTestDatabase('pg_pool_one');
+  const db = await initPgDatabase(created.url);
+  try {
+    let timer: NodeJS.Timeout | undefined;
+    const deadlock = new Promise<never>((_, reject) => {
+      timer = setTimeout(
+        () => reject(new Error(`deadlock: migrações não terminaram em ${MIGRATION_TIMEOUT_MS}ms com PG_POOL_MAX=1`)),
+        MIGRATION_TIMEOUT_MS,
+      );
+    });
+    try {
+      await Promise.race([runCentralMigrations(db), deadlock]);
+      await Promise.race([runCentralMigrations(db), deadlock]); // idempotente, ainda com 1 conexão
+    } finally {
+      if (timer) clearTimeout(timer);
+    }
+
+    const columns = await db.all(`SELECT column_name AS name FROM information_schema.columns WHERE table_schema='public' AND table_name='reviews'`);
+    const names = columns.map((row: any) => String(row.name).toLowerCase());
+    assert.ok(names.includes('createdat'), 'coluna canônica deve existir após migração');
+
+    // Pool continua utilizável depois que o lock devolve a única conexão.
+    const ok = await db.get<{ ok: number }>('SELECT 1 AS ok');
+    assert.equal(ok?.ok, 1);
+
+    // Nenhuma conexão extra foi necessária: só a do próprio teste permanece.
+    const others = await db.get<{ c: number }>(
+      `SELECT count(*)::int AS c FROM pg_stat_activity
+        WHERE datname = current_database() AND pid <> pg_backend_pid()`,
+    );
+    assert.equal(Number(others?.c), 0, 'migração não pode abrir conexões extras além da conexão do lock');
+  } finally {
+    await db.close();
+    if (previousMax === undefined) delete process.env.PG_POOL_MAX;
+    else process.env.PG_POOL_MAX = previousMax;
+    await dropTestDatabase(created.name);
+  }
+});
