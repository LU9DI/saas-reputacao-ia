+      let connectionLost = false;
+      let result: T | undefined;
+      let failure: unknown;
+      let unlockFailure: unknown;
+
+      const onConnectionError = (error: Error) => {
+        connectionLost = true;
+        console.error('[migrations] conexão dedicada do lock PostgreSQL perdida:', describePgError(error));
+      };
